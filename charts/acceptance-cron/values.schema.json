{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["worker", "preparation", "job"],
  "properties": {
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["containerRef"],
      "properties": {
        "containerRef": {"type": "string", "pattern": "^.+@sha256:[a-f0-9]{64}$"}
      }
    },
    "preparation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref"],
      "properties": {
        "ref": {"type": "string", "pattern": "^.+@sha256:[a-f0-9]{64}$"}
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schedule", "backoffLimit", "suspend"],
      "properties": {
        "schedule": {"type": "string", "minLength": 9},
        "backoffLimit": {"type": "integer", "minimum": 0, "maximum": 3},
        "suspend": {"type": "boolean"}
      }
    }
  }
}
